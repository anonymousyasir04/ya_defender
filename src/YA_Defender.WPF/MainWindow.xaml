<Window x:Class="YA_Defender.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YA_Defender.WPF.ViewModels"
        xmlns:views="clr-namespace:YA_Defender.WPF.Views"
        Title="YA Defender"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Foreground="{StaticResource AccentBrush}">YA</Run>
                        <Run Foreground="{StaticResource HighlightBrush}"> DEFENDER</Run>
                    </TextBlock>
                    <TextBlock Text="Ultimate Malware Defense" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Created by Yasir Abbas" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgAltBrush}"
                        Padding="14,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Protected" FontSize="12"
                                   Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="Real-time monitoring active" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Margin="0,0,14,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Selected}" />
    </Grid>
</Window>
