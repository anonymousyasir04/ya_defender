<UserControl x:Class="YA_Defender.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="HOME" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Live defense dashboard - monitoring your system in real time"
                       Style="{StaticResource SubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Files Watched" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding SafeCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="Threats Neutralized" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding ThreatCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="Files Scanned" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding CleanCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="System Integrity" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource HighlightBrush}">
                        <Run Text="{Binding Integrity, StringFormat={}{0:F0}%}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastUpdate, StringFormat=Updated {0}}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIVE THREAT FEED" Style="{StaticResource CardTitleStyle}" />
                    <Button DockPanel.Dock="Top" Content="Clear Feed" HorizontalAlignment="Right"
                            Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                            Command="{Binding ClearFeedCommand}" Margin="0,-24,0,6" />
                    <ListBox ItemsSource="{Binding Feed}" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding Color}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="THREAT HUNTER SEARCH" Style="{StaticResource CardTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="process:name, file:pattern, ip:..., threat:..." />
                            <Button Grid.Column="1" Content="Search" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SearchSummary}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" />
                        <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                                 MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Table}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Risk}" FontSize="11" Foreground="{StaticResource HighlightBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LIVE NETWORK CONNECTIONS" Style="{StaticResource CardTitleStyle}" />
                        <ListBox ItemsSource="{Binding Connections}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" FontFamily="Consolas">
                                        <Run Text="{Binding ProcessName}" Foreground="{StaticResource TextBrush}" />
                                        <Run Text=" -> " Foreground="{StaticResource TextDimBrush}" />
                                        <Run Text="{Binding DestinationIp, StringFormat='{}{0}'}" Foreground="{StaticResource AccentBrush}" />
                                        <Run Text="{Binding DestinationPort, StringFormat=':{0}'}" Foreground="{StaticResource TextDimBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,6,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIVE TERMINAL LOG" Style="{StaticResource CardTitleStyle}" />
                <ListBox ItemsSource="{Binding Terminal}" Background="#060D1D" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="False" FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#4CC38A" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
