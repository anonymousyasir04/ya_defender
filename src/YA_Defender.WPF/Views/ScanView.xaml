<UserControl x:Class="YA_Defender.WPF.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}"
             AllowDrop="True"
             PreviewDragOver="OnDragOver" Drop="OnDrop">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SCAN" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Deep scan engine - PE analysis, heuristics, signatures and cloud verdicts in parallel"
                       Style="{StaticResource SubtitleStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <Button Content="Quick Scan" Style="{StaticResource PrimaryButton}" Command="{Binding QuickScanCommand}" Margin="0,0,8,0" />
            <Button Content="Full Scan" Style="{StaticResource GhostButton}" Command="{Binding FullScanCommand}" Margin="0,0,8,0" />
            <Button Content="Custom Scan" Style="{StaticResource GhostButton}" Command="{Binding CustomScanCommand}" Margin="0,0,8,0" />
            <Button Content="USB Drive Scan" Style="{StaticResource GhostButton}" Command="{Binding UsbScanCommand}" Margin="0,0,8,0" />
            <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" />
            <TextBlock Text="{Binding ScanLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drag &amp; drop files or folders here to analyze instantly"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Height="8" Margin="0,10,0,6" Value="{Binding Percent}" Maximum="100" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentFile}" FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding EtaText}" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="SCAN RESULTS" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Right" Text="Click a path to open it in Explorer"
                               Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Top" Content="Export Report" HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"
                        Command="{Binding ExportCommand}" Margin="0,-24,0,6" />
                <ListView ItemsSource="{Binding Results}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{Binding RiskColor}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"
                                               ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ThreatType}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding RiskColor}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding RiskScore}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding RiskColor}" FontWeight="Bold" />
                                <TextBlock Grid.Column="4" Text="{Binding Method}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding DetectedAt}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <Button Grid.Column="6" Content="Open" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding FilePath}" Margin="4,0" />
                                <Button Grid.Column="7" Content="Quarantine" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.QuarantineCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0"
                                        Visibility="{Binding IsThreat, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LIVE SCAN LOG" Style="{StaticResource CardTitleStyle}" />
                <ListBox ItemsSource="{Binding Terminal}" Background="#060D1D" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="False" FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#4CC38A" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
